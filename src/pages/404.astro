---
import Button from "#/components/button.astro";
import Content from "#/components/content.astro";
import Main from "#/components/main.astro";
import Layout from "#/layouts/layout.astro";
import { link } from "astro-typed-links/link";
---

<Layout title="Not found">
	<Main>
		<Content
			headingText="404"
			isSeamless
			classes={{
				heading: "w-full justify-center dark:text-blue",
				headingText: "font-black text-6xl -tracking-widest",
				body: "items-center"
			}}
		>
			<p class="text-center">This page could not be found.</p>

			<Button as="a" href={link("/")}>home</Button>
		</Content>
	</Main>
</Layout>
