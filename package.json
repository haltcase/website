{
	"name": "@haltcase/website",
	"version": "2.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "pnpm lint && astro build",
		"build:check": "astro check && svelte-check",
		"check": "vp check",
		"dev": "astro dev",
		"eslint:check": "eslint .",
		"format": "eslint --fix . && vp fmt",
		"postinstall": "astro sync",
		"lint": "pnpm eslint:check && pnpm prettier:check && pnpm typescript:check && pnpm build:check",
		"prepare": "vp config",
		"prettier:check": "vp fmt --check .",
		"start": "node ./dist/server/entry.mjs",
		"typescript:check": "tsc --noEmit"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/svelte": "^9.0.1",
		"@astrojs/vercel": "^11.0.3",
		"@fontsource-variable/overpass": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@iconify-json/simple-icons": "^1.2.91",
		"@iconify-json/tabler": "^1.2.37",
		"astro": "^7.1.3",
		"astro-icon": "^1.1.5",
		"astro-themes": "^0.2.7",
		"astro-typed-links": "^2.0.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.7",
		"tailwind-merge": "^3.6.0",
		"wretch": "^2.11.0"
	},
	"devDependencies": {
		"@haltcase/style": "^7.2.2",
		"@tailwindcss/vite": "^4.3.3",
		"eslint": "9.39.5",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@11.15.1",
	"engines": {
		"node": "24"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.15.1",
			"onFail": "download"
		}
	}
}
